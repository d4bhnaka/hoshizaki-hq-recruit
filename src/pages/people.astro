---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import BottomCta from "../components/BottomCta.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import PeopleCard from "../components/PersonCard.astro";
import { people, entryLabel } from "../data/persons";

const base = "../";

// --------------------------------------------------------------------------
// 絞り込みフィルター（職種・属性で絞り込み）
// 値はカードの data-people-tags（英語トークン）と突き合わせる。
// 新卒入社 / 中途入社 は people.ts の tags（newgrad|midcareer）と対応。
// --------------------------------------------------------------------------
const filters = [
  { label: "すべて", value: "all", active: true },
  { label: "技術系", value: "tech" },
  { label: "企画管理系", value: "admin" },
  { label: "理系", value: "science" },
  { label: "文系", value: "humanities" },
  { label: "新卒入社", value: "newgrad" },
  { label: "中途入社", value: "midcareer" },
];

// 一覧カードのデータ・入社年表記（entryLabel）は src/data/persons.ts に集約。
---

<Layout
  basePath={base}
  title="はたらく人を知る｜ホシザキ本社採用サイト"
  description="ホシザキで働く先輩社員たちの「ここに決めた！」理由を職種別に紹介。技術系・企画管理系で活躍する先輩のリアルな声を掲載しています。"
>
  <div class="l-container">
    <Header basePath={base} />
    <main class="l-main">
      <article class="p-people">
        <PageHero en="People" ja="はたらく人を知る" variant="cloud">
          <p class="p-people__catch" data-inview="pop">
            <img
              class="p-people__catch-img"
              src={`${base}images/person/copy.webp`}
              alt="先輩たちの「ここに決めた！」"
              width="531"
              height="143"
            />
          </p>
        </PageHero>

        <!-- Filter tabs -->
        <section class="p-people__filter" aria-label="職種・属性で絞り込み">
          <ul class="p-people__filter-list">
            {
              filters.map((f, i) => (
                <li class="p-people__filter-item">
                  <button
                    type="button"
                    class="p-people__filter-btn"
                    data-people-filter={f.value}
                    aria-pressed={f.active ? "true" : "false"}
                    data-inview="fade"
                    style={`--inview-i: ${Math.min(i, 5)}`}
                  >
                    {f.label}
                  </button>
                </li>
              ))
            }
          </ul>
        </section>

        <!-- People card grid -->
        <section class="p-people__grid-section" aria-label="社員一覧">
          <ul class="p-people__grid">
            {
              people.map((p) => (
                <li
                  class="p-people__grid-item"
                  data-people-card
                  data-people-tags={p.tags.join(" ")}
                >
                  <PeopleCard
                    image={`${base}images/person/${p.image}`}
                    jobType={p.jobType}
                    entry={entryLabel(p)}
                    body={p.body}
                    category={p.category}
                    href={`./${p.slug}/`}
                  />
                </li>
              ))
            }
          </ul>
          <p class="p-people__empty" data-people-empty hidden>
            該当する社員が見つかりませんでした。
          </p>
        </section>

        <!-- Bottom CTA -->
        <BottomCta basePath={base} />

        <!-- Breadcrumb -->
        <div class="p-people__breadcrumb">
          <Breadcrumb basePath={base} items={[{ label: "はたらく人を知る" }]} />
        </div>
      </article>
    </main>
    <Footer basePath={base} />
  </div>
</Layout>